# ============================================================
# ChatOnline — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# In PRODUCTION (FLASK_ENV=production), ALL values below are REQUIRED.
# In DEVELOPMENT, only ADMIN_USERNAME and ADMIN_PASSWORD are required
# (other values will use safe defaults).

# ── Environment ─────────────────────────────────────────────
FLASK_ENV=development          # development | production | testing
DEBUG=false                   # Enable debug mode (dev only)
PORT=5001                     # Server port

# ── Security (REQUIRED in production) ────────────────────────
# Must be at least 32 characters, cryptographically strong.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=                   # Flask secret key
JWT_SECRET=                   # JWT signing secret (min 32 chars)

# ── Admin Access (REQUIRED always) ─────────────────────────
# These MUST be set — no defaults.
ADMIN_USERNAME=               # Admin username
ADMIN_PASSWORD=               # Admin password (min 10 chars)

# ── Database ────────────────────────────────────────────────
# SQLite: sqlite:///chat_online.db
# PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///chat_online.db

# ── Redis (optional, for production scaling) ───────────────
REDIS_URL=                    # e.g. redis://localhost:6379/0

# ── Email (optional, for verification emails) ───────────────
MAIL_SERVER=                  # e.g. smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=               # Your email address
MAIL_PASSWORD=                # App-specific password

# ── Cookies ────────────────────────────────────────────────
# Set SESSION_COOKIE_SECURE=true in production (requires HTTPS)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# ── Socket.IO ──────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all (dev only)
SOCKETIO_CORS_ORIGINS=*
SOCKETIO_ASYNC_MODE=threading

# ── Moderation ──────────────────────────────────────────────
MODERATION_ENABLED=true

# ── Verification ────────────────────────────────────────────
VERIFICATION_CODE_EXPIRY=10   # Minutes
PASSWORD_RESET_EXPIRY=30      # Minutes

# ── Rate Limiting ──────────────────────────────────────────
RATELIMIT_DEFAULT=200 per day
